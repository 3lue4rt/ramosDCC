# Dockerfile para servidor CaDCC con Caddy proxy
FROM python:3.12-slim

# Variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=ramosDcc.settings_cadcc

# Directorio de trabajo
WORKDIR /app

# Instalar dependencias del sistema
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements e instalar dependencias Python
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código de la aplicación
COPY ramosDcc/ /app/
COPY start-caddy.sh /app/

# Permisos y directorios
RUN chmod +x /app/start-caddy.sh
RUN mkdir -p /app/data /app/logs /app/staticfiles /app/media

# Usuario no root
RUN adduser --disabled-password --gecos '' appuser && chown -R appuser /app
USER appuser

# Puerto interno (Caddy se conectará aquí)
EXPOSE 8000

# Comando de inicio
CMD ["/app/start-caddy.sh"]
